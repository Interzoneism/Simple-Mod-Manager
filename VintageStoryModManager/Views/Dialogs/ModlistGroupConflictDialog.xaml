<Window x:Class="VintageStoryModManager.Views.Dialogs.ModlistGroupConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix Duplicate Mods"
        Width="760"
        MinHeight="360"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Shell.Background.Solid}">
    <Grid Margin="20" TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock FontSize="19" FontWeight="Bold" Text="Choose which modlist wins for each duplicate mod" />
            <TextBlock Margin="0,5,0,0"
                       Opacity="0.8"
                       Text="Selections are saved on the group. Versions and included custom configurations come from the chosen entry."
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="540" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Selections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="12"
                                Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
                                BorderBrush="{DynamicResource Brush.Dialog.TextBox.Border}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Text="{Binding ModId}"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="440"
                                          ItemsSource="{Binding Choices}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,12,0"
                    IsDefault="True"
                    Click="SaveButton_OnClick"
                    Content="Save choices" />
            <Button MinWidth="88" IsCancel="True" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
